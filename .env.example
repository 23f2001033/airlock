# Caspian -- created by `caspian init`
CASPIAN_API_KEY=comm_xxxxxxxxxxxxxxxxxxxx
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Trusted channel. Create a bot with @BotFather on Telegram and paste its token.
# Without this there is no trusted channel, and nothing can ever be approved.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Inference (Featherless -- the hackathon's inference partner).
# Optional: without it the planner falls back to deterministic rules, so the
# demo still runs offline.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional overrides
AIRLOCK_EMAIL_USER=airlock-agent
